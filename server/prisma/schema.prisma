generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {                  // e.g. Pranav
  id              Int       @id @default(autoincrement())
  email           String    @unique
  password        String    
  workouts        Workout[]
}

enum  MuscleRole{
  PRIMARY
  SECONDARY
  TERTIARY
}

model Exercise {                // e.g. "Barbell Chest Press"
  id           Int              @id @default(autoincrement())
  name         String           @unique
  instructions String?
  imageUrl     String?  
  videoUrl     String?  

  muscles      ExerciseMuscle[]
  workout      WorkoutExercise[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([name])
}

model Muscle {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  exercises     ExerciseMuscle[]
}

model ExerciseMuscle {
  exerciseId    Int
  muscleId      Int 
  role          MuscleRole
  exercise      Exercise  @relation(fields:[exerciseId],references:id, onDelete: Cascade)
  muscle        Muscle    @relation(fields:[muscleId],references:id,onDelete:Cascade)

  @@id([exerciseId, muscleId])
  @@index([muscleId])  
}

model Workout {
  id           Int              @id @default(autoincrement())
  name         String
  userId       Int            
  user         User             @relation(fields:[userId], references:[id], onDelete:Cascade)

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  exercises    WorkoutExercise[]

  @@index([userId])
}

model WorkoutExercise{
  workoutId    Int
  exerciseId   Int

  exercise     Exercise          @relation(fields:[exerciseId], references:[id],onDelete:Cascade)
  workout      Workout           @relation(fields:[workoutId], references:[id], onDelete:Cascade)

  sets         Int               @default(3)
  reps         Int               @default(12)
  rest         Int               @default(120)

  @@id([workoutId,exerciseId])
}